{
  "docs": {
    "fps": "fps = 20 * (songBpm / 120). Reference: 20 frames = 1 second at 120 BPM.",
    "addSheet": [
      "Drop TexturePacker files under public/runtime-2d/spritesheets/ (character subfolder optional).",
      "Need name.tpsheet plus atlas PNG(s): name-0.png and name-1.png when multi-page, or the exact image listed in the tpsheet.",
      "Add the relative tpsheet path to sheetFiles, keyed by a short sheet id.",
      "Point characters.<id>.instruments.<instrument>.sheet at that id. Optional .icon overrides the sticker filename.",
      "Point characters.<id>.tokens.<mega-suffix> at a sheet id (latin_agogo matches token agogo). Exact characters.<id>.instruments.<id> still wins.",
      "Optional characters.<id>.genreSheets.<instrument-or-token>.<genre> picks a pose variant.",
      "Stickers: icons (exact stem id), iconTokens (suffix), kindIcons (instrumentKind()), then genreIcons."
    ]
  },
